# 로컬 체험 전용. production은 미완료 연동을 사용하지 않도록 시작 단계에서 차단됩니다.
APP_MODE=local
# Docker Compose는 컨테이너 내부에서만 0.0.0.0으로 설정합니다.
# HOST=127.0.0.1
PORT=4174
RUNTIME_PORT=4175
# npm run dev: http://localhost:5173 / npm start: http://localhost:4174
# MANAGE_ORIGIN=http://localhost:5173
RUNTIME_ORIGIN=http://127.0.0.1:4175
# DB_PATH=/absolute/path/to/platform.sqlite
# STORAGE_PATH=/absolute/path/to/storage
# 토큰 저장을 시험할 경우 32바이트 hex 키를 별도 비밀 저장소에서 제공하세요.
# TOKEN_MASTER_KEY=
# 로컬 MCP 클라이언트의 관리 API 주소
SANDBOX_URL=http://127.0.0.1:4174

# AI 공급자: Ollama (API 키 불필요)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 설치된 모델 중 기본 제안 모델. 생략하면 가장 작은 로컬 대화 모델을 제안합니다.
# OLLAMA_MODEL=qwen3.5:latest
OLLAMA_TIMEOUT_MS=120000

# Docker Compose 전용 (기본 실행에는 .env가 필요하지 않습니다.)
# KIKA_MANAGE_PORT=4174
# KIKA_RUNTIME_PORT=4175
# ai 프로필의 Ollama를 기본 사용합니다. 기존 호스트 Ollama 연결 시:
# KIKA_OLLAMA_BASE_URL=http://host.docker.internal:11434
